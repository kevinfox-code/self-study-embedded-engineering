{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "format-all",
            "type": "shell",
            "command": "find ${workspaceFolder}/Src ${workspaceFolder}/Inc ${workspaceFolder}/tests -name '*.c' -o -name '*.h' | xargs clang-format -i",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "build-mtpa",
            "type": "shell",
            "command": "cmake -S ${workspaceFolder} -B ${workspaceFolder}/build && cmake --build ${workspaceFolder}/build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "build-release",
            "type": "shell",
            "command": "cmake -S ${workspaceFolder} -B ${workspaceFolder}/build-release -DCMAKE_BUILD_TYPE=Release && cmake --build ${workspaceFolder}/build-release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "build-dma",
            "type": "shell",
            "command": "cmake -S ${workspaceFolder} -B ${workspaceFolder}/build-dma -DFEATURE_UART_DMA=ON && cmake --build ${workspaceFolder}/build-dma",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "build-lint",
            "type": "shell",
            "command": "cmake -S ${workspaceFolder} -B ${workspaceFolder}/build-lint -DENABLE_LINT=ON && cmake --build ${workspaceFolder}/build-lint",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "clean-mtpa",
            "type": "shell",
            "command": "rm -rf ${workspaceFolder}/build ${workspaceFolder}/build-debug ${workspaceFolder}/build-dma ${workspaceFolder}/build-lint ${workspaceFolder}/build-release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "flash-mtpa",
            "type": "shell",
            "command": "cmake -S ${workspaceFolder} -B ${workspaceFolder}/build && cmake --build ${workspaceFolder}/build --target flash",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        }
    ]
}